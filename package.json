{
  "name": "sonnensystem",
  "private": true,
  "version": "10.0.0",
  "description": "Animierte 3D-Reise durch das Sonnensystem (three.js r128, ES-Module, Vite)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:artifact": "node tools/artifact/build.mjs",
    "build:test": "vite build --mode test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:file": "node tools/e2e-file.mjs",
    "shots": "node tools/shots/run.js",
    "docs:map": "node tools/docs/modulkarte.mjs"
  },
  "dependencies": {
    "three": "0.128.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "playwright": "^1.56.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
